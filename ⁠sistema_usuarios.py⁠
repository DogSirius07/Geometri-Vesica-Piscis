<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Individual de Usuários</title>
    <style>
        :root {
            --bg: #f4f4f4; --card: #ffffff; --text: #333333; --btn: #007bff;
        }
        body { background-color: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; box-sizing: border-box; transition: 0.3s; }
        .card { background-color: var(--card); padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 360px; box-sizing: border-box; }
        input, select { width: 100%; padding: 12px; margin: 8px 0 16px 0; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; font-size: 16px; }
        button { background-color: var(--btn); color: white; border: none; padding: 12px; width: 100%; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 16px; margin-top: 5px; }
        button:active { opacity: 0.8; }
        .msg { font-size: 14px; text-align: center; margin-bottom: 10px; min-height: 20px; }
        .error { color: #ff3b30; }
        .success { color: #34c759; }
        a { color: var(--btn); text-decoration: none; display: block; text-align: center; margin-top: 15px; font-size: 14px; cursor: pointer; }
        .hidden { display: none; }
        h2 { text-align: center; margin-top: 0; }
    </style>
</head>
<body>

<div class="card" id="app">
    <div id="msg" class="msg"></div>

    <div id="view-login">
        <h2>Entrar</h2>
        <input type="text" id="login-user" placeholder="Usuário">
        <input type="password" id="login-pass" placeholder="Senha">
        <button onclick="fazerLogin()">Entrar</button>
        <a onclick="mudarTela('esqueci')">Esqueci minha senha</a>
        <a onclick="mudarTela('cadastro')">Criar nova conta</a>
    </div>

    <div id="view-dashboard" class="hidden">
        <h2 id="dash-title">Painel</h2>
        <p id="dash-tema-txt" style="text-align: center; font-size: 14px;"></p>
        <hr style="border: 0; border-top: 1px solid #ddd; margin: 15px 0;">
        <button onclick="mudarTela('config')">Minhas Configurações</button>
        <button onclick="mudarTela('novo-usuario')" style="background-color: #5856d6;">Adicionar Novo Usuário</button>
        <a onclick="fazerLogout()" style="color: #ff3b30; margin-top: 25px;">Sair da Conta</a>
    </div>

    <div id="view-config" class="hidden">
        <h2>Configurações</h2>
        <label>Nova Senha (opcional):</label>
        <input type="password" id="cfg-senha" placeholder="Deixe em branco para manter">
        <label>Pergunta Secreta:</label>
        <input type="text" id="cfg-pergunta">
        <label>Nova Resposta Secreta:</label>
        <input type="text" id="cfg-resposta" placeholder="Digite para alterar">
        <label>Tema do Painel:</label>
        <select id="cfg-tema">
            <option value="Rose Gold">Rose Gold</option>
            <option value="Matrix Esmerald">Matrix Esmerald</option>
            <option value="Midnight Blue">Midnight Blue</option>
            <option value="Claro Padrão">Claro Padrão</option>
        </select>
        <button onclick="salvarConfiguracoes()">Salvar Alterações</button>
        <a onclick="mudarTela('dashboard')">Voltar ao Painel</a>
    </div>

    <div id="view-esqueci" class="hidden">
        <h2>Recuperação</h2>
        <input type="text" id="esq-user" placeholder="Digite seu usuário">
        <button onclick="buscarPergunta()">Avançar</button>
        <a onclick="mudarTela('login')">Voltar ao Login</a>
    </div>

    <div id="view-pergunta" class="hidden">
        <h2>Recuperação</h2>
        <p id="lbl-pergunta" style="font-weight: bold; text-align: center;"></p>
        <input type="text" id="esq-resposta" placeholder="Sua resposta secreta">
        <input type="password" id="esq-novasenha" placeholder="Nova senha">
        <button onclick="redefinirSenha()">Redefinir Senha</button>
        <a onclick="mudarTela('login')">Voltar ao Login</a>
    </div>

    <div id="view-cadastro" class="hidden">
        <h2 id="cad-titulo">Criar Conta</h2>
        <input type="text" id="cad-user" placeholder="Nome de usuário">
        <input type="password" id="cad-pass" placeholder="Senha padrão inicial">
        <input type="text" id="cad-pergunta" placeholder="Pergunta secreta">
        <input type="text" id="cad-resposta" placeholder="Resposta secreta">
        <select id="cad-tema">
            <option value="Rose Gold">Rose Gold</option>
            <option value="Matrix Esmerald">Matrix Esmerald</option>
            <option value="Midnight Blue">Midnight Blue</option>
            <option value="Claro Padrão">Claro Padrão</option>
        </select>
        <button onclick="salvarNovoUsuario()">Cadastrar</button>
        <a id="cad-voltar" onclick="mudarTela('login')">Voltar ao Login</a>
    </div>
</div>

<script>
    const temas = {
        "Rose Gold": { bg: "#fdf2f2", card: "#ffffff", text: "#4a3b3c", btn: "#d4a5a5" },
        "Matrix Esmerald": { bg: "#0d1117", card: "#161b22", text: "#00ff66", btn: "#238636" },
        "Midnight Blue": { bg: "#0f172a", card: "#1e293b", text: "#e2e8f0", btn: "#3b82f6" },
        "Claro Padrão": { bg: "#f4f4f4", card: "#ffffff", text: "#333333", btn: "#007bff" }
    };

    if (!localStorage.getItem('usuarios')) {
        const inicial = {
            "admin": { senha: "123", pergunta: "Qual seu pet?", resposta: "rex", tema: "Rose Gold" }
        };
        localStorage.setItem('usuarios', JSON.stringify(inicial));
    }

    let usuarioLogado = localStorage.getItem('usuarioLogado') || null;

    function aplicarTema(nomeTema) {
        let t = temas[nomeTema] || temas["Claro Padrão"];
        document.documentElement.style.setProperty('--bg', t.bg);
        document.documentElement.style.setProperty('--card', t.card);
        document.documentElement.style.setProperty('--text', t.text);
        document.documentElement.style.setProperty('--btn', t.btn);
    }

    function mostrarMsg(texto, tipo) {
        let m = document.getElementById('msg');
        m.className = "msg " + tipo;
        m.innerText = texto;
        setTimeout(() => m.innerText = "", 4000);
    }

    function mudarTela(tela) {
        document.querySelectorAll('#app > div').forEach(d => d.classList.add('hidden'));
        document.getElementById('msg').innerText = "";

        if (tela === 'login') {
            document.getElementById('view-login').classList.remove('hidden');
            aplicarTema("Claro Padrão");
        } else if (tela === 'dashboard') {
            document.getElementById('view-dashboard').classList.remove('hidden');
            let db = JSON.parse(localStorage.getItem('usuarios'));
            let uData = db[usuarioLogado];
            document.getElementById('dash-title').innerText = "Olá, " + usuarioLogado;
            document.getElementById('dash-tema-txt').innerText = "Tema ativo: " + uData.tema;
            aplicarTema(uData.tema);
        } else if (tela === 'config') {
            let db = JSON.parse(localStorage.getItem('usuarios'));
            let uData = db[usuarioLogado];
            document.getElementById('cfg-pergunta').value = uData.pergunta;
            document.getElementById('cfg-resposta').value = "";
            document.getElementById('cfg-senha').value = "";
            document.getElementById('cfg-tema').value = uData.tema;
            document.getElementById('view-config').classList.remove('hidden');
        } else if (tela === 'esqueci') {
            document.getElementById('view-esqueci').classList.remove('hidden');
        } else if (tela === 'cadastro') {
            document.getElementById('cad-titulo').innerText = "Criar Conta";
            document.getElementById('cad-voltar').setAttribute("onclick", "mudarTela('login')");
            document.getElementById('view-cadastro').classList.remove('hidden');
        } else if (tela === 'novo-usuario') {
            document.getElementById('cad-titulo').innerText = "Adicionar Novo Usuário";
            document.getElementById('cad-user').value = "";
            document.getElementById('cad-pass').value = "";
            document.getElementById('cad-pergunta').value = "";
            document.getElementById('cad-resposta').value = "";
            document.getElementById('cad-voltar').setAttribute("onclick", "mudarTela('dashboard')");
            document.getElementById('view-cadastro').classList.remove('hidden');
        }
    }

    function fazerLogin() {
        let u = document.getElementById('login-user').value.trim();
        let p = document.getElementById('login-pass').value;
        let db = JSON.parse(localStorage.getItem('usuarios'));

        if (db[u] && db[u].senha === p) {
            usuarioLogado = u;
            localStorage.setItem('usuarioLogado', u);
            mudarTela('dashboard');
        } else {
            mostrarMsg("Usuário ou senha incorretos!", "error");
        }
    }

    function salvarConfiguracoes() {
        let db = JSON.parse(localStorage.getItem('usuarios'));
        let senhaNova = document.getElementById('cfg-senha').value;
        let pNova = document.getElementById('cfg-pergunta').value;
        let rNova = document.getElementById('cfg-resposta').value.trim().toLowerCase();
        let tNovo = document.getElementById('cfg-tema').value;

        if (senhaNova) db[usuarioLogado].senha = senhaNova;
        if (pNova) db[usuarioLogado].pergunta = pNova;
        if (rNova) db[usuarioLogado].resposta = rNova;
        db[usuarioLogado].tema = tNovo;

        localStorage.setItem('usuarios', JSON.stringify(db));
        mostrarMsg("Atualizado com sucesso!", "success");
        setTimeout(() => mudarTela('dashboard'), 1000);
    }

    let usuarioRecuperando = "";
    function buscarPergunta() {
        let u = document.getElementById('esq-user').value.trim();
        let db = JSON.parse(localStorage.getItem('usuarios'));
        if (db[u]) {
            usuarioRecuperando = u;
            document.getElementById('lbl-pergunta').innerText = "Pergunta: " + db[u].pergunta;
            document.getElementById('view-esqueci').classList.add('hidden');
            document.getElementById('view-pergunta').classList.remove('hidden');
        } else {
            mostrarMsg("Usuário não encontrado!", "error");
        }
    }

    function redefinirSenha() {
        let resp = document.getElementById('esq-resposta').value.trim().toLowerCase();
        let novaS = document.getElementById('esq-novasenha').value;
        let db = JSON.parse(localStorage.getItem('usuarios'));

        if (db[usuarioRecuperando].resposta === resp) {
            db[usuarioRecuperando].senha = novaS;
            localStorage.setItem('usuarios', JSON.stringify(db));
            mostrarMsg("Senha alterada com sucesso!", "success");
            setTimeout(() => mudarTela('login'), 1500);
        } else {
            mostrarMsg("Resposta secreta incorreta!", "error");
        }
    }

    function salvarNovoUsuario() {
        let u = document.getElementById('cad-user').value.trim();
        let p = document.getElementById('cad-pass').value;
        let perg = document.getElementById('cad-pergunta').value;
        let resp = document.getElementById('cad-resposta').value.trim().toLowerCase();
        let tema = document.getElementById('cad-tema').value;

        if (!u || !p || !perg || !resp) {
            mostrarMsg("Preencha todos os campos!", "error");
            return;
        }

        let db = JSON.parse(localStorage.getItem('usuarios'));
        if (db[u]) {
            mostrarMsg("Usuário já existe!", "error");
            return;
        }

        db[u] = { senha: p, pergunta: perg, resposta: resp, tema: tema };
        localStorage.setItem('usuarios', JSON.stringify(db));
        mostrarMsg("Usuário criado com sucesso!", "success");
        
        setTimeout(() => {
            if (usuarioLogado) mudarTela('dashboard');
            else mudarTela('login');
        }, 1000);
    }

    function fazerLogout() {
        usuarioLogado = null;
        localStorage.removeItem('usuarioLogado');
        mudarTela('login');
    }

    if (usuarioLogado && JSON.parse(localStorage.getItem('usuarios'))[usuarioLogado]) {
        mudarTela('dashboard');
    } else {
        mudarTela('login');
    }
</script>

</body>
</html>
